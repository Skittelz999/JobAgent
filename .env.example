# Kopiera denna fil till .env i projektroten om du vill lagra miljövariabler lokalt.
# .env ignoreras av Git (.gitignore). Riktiga miljövariabler i terminalen har företräde.

# OpenAI API (valfritt — behövs endast när JOBAGENT_LLM_PROVIDER=openai)
# JOBAGENT_LLM_PROVIDER=openai
# JOBAGENT_OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=sk-...

# Lokal modell (LM Studio)
# JOBAGENT_LLM_BASE_URL=http://127.0.0.1:1234/v1
# JOBAGENT_LLM_MODEL=openai/gpt-oss-20b

# Databas och källa (valfritt)
# JOBAGENT_DATABASE=var/jobagent.sqlite3
# JOBAGENT_API_BASE_URL=https://jobsearch.api.jobtechdev.se
